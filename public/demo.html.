
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Social App — Login Demo</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #fafafa;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}
.container { width: 350px; text-align: center; }
.panel {
  background: white;
  border: 1px solid #ddd;
  padding: 38px 35px 25px;
}
.logo {
  font-family: cursive;
  font-size: 43px;
  margin-bottom: 30px;
}
input {
  width: 100%;
  padding: 12px;
  margin-bottom: 8px;
  border: 1px solid #dbdbdb;
  border-radius: 4px;
  background: #fafafa;
}
button {
  width: 100%;
  padding: 10px;
  border: 0;
  border-radius: 7px;
  background: #3897f0;
  color: white;
  font-weight: bold;
  margin-top: 10px;
}
.demo {
  background: #fff4d6;
  border: 1px solid #e8d39b;
  padding: 12px;
  margin-top: 15px;
  font-size: 12px;
  line-height: 1.5;
}
</style>
</head>
<body>
<div class="container">
  <div class="panel">
    <div class="logo">Social</div>
    <p>Security awareness login mockup</p>
    <form id="demo">
      <input placeholder="Demo username" required>
      <input type="password" placeholder="Dummy password" required>
      <button type="submit">Continue</button>
    </form>
    <p id="message"></p>
    <div class="demo">
      DEMONSTRATION ONLY<br>
      This is not Instagram. Never enter real account credentials.
    </div>
  </div>
</div>
<script>
document.getElementById("demo").addEventListener("submit", function(e) {
  e.preventDefault();
  this.reset();
  document.getElementById("message").textContent =
    "Demo completed. Always verify the website before signing in.";
});
</script>
</body>
</html>
