
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhotoShare — Security Demo</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #fafafa;
  font-family: Arial, sans-serif;
}
.card {
  width: 350px;
  padding: 35px 30px;
  background: white;
  border: 1px solid #ddd;
  text-align: center;
}
.logo { font-size: 32px; font-weight: bold; margin-bottom: 25px; }
input, button {
  width: 100%;
  padding: 13px;
  margin: 6px 0;
  border: 1px solid #ddd;
  border-radius: 5px;
}
button {
  background: #3897f0;
  color: white;
  border: 0;
  font-weight: bold;
  cursor: pointer;
}
.notice {
  margin-top: 22px;
  padding: 12px;
  background: #fff4d6;
  font-size: 13px;
  line-height: 1.5;
}
</style>
</head>
<body>
<div class="card">
  <div class="logo">PhotoShare</div>
  <p>Security Awareness Demonstration</p>
  <form id="demo">
    <input placeholder="Demo username" autocomplete="off" required>
    <input placeholder="Dummy password" type="password" autocomplete="off" required>
    <button type="submit">Continue</button>
  </form>
  <div id="result"></div>
  <div class="notice">
    Training demo only. Never enter your real Instagram password
    into an unfamiliar website.
  </div>
</div>
<script>
document.getElementById("demo").addEventListener("submit", function(e) {
  e.preventDefault();
  this.reset();
  document.getElementById("result").textContent =
    "Demo complete! Always verify the website before signing in.";
});
</script>
</body>
</html>
