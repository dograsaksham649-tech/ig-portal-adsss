# Copy to .env and replace every placeholder. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters

# First-run administrator. The password is hashed before it is stored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Meta Developer App settings
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
META_API_VERSION=v27.0
